# ALGOps environment (copy to .env). Every variable is optional (sane dev defaults apply).

# --- Master (server A) ---
ALGOPS_MASTER_PORT=8000
ALGOPS_MASTER_DEV_MODE=true                    # workflows in-process. false => Celery workers (prod)
ALGOPS_MASTER_DB_URL=sqlite+pysqlite:///./.algops/tracking.sqlite
ALGOPS_MASTER_ARTIFACT_DIR=./.algops/artifacts
ALGOPS_MASTER_CHECKPOINT_DB=./.algops/checkpoints.sqlite
ALGOPS_MASTER_ENROLL_TOKEN=dev-enroll-token    # token runners present at registration
# ALGOPS_MASTER_API_TOKEN=                      # set => mutating API calls need "Authorization: Bearer <token>"
# ALGOPS_MASTER_SCHEDULER_ENABLED=true          # cron + git-watch loop (enable in ONE master process)
# ALGOPS_MASTER_RUN_RETRIES=1                   # re-dispatch a run to another runner on infra failure
# ALGOPS_MASTER_BENCHMARK_MAX_PARALLEL=0        # 0 => total online runner concurrency
# ALGOPS_MASTER_PROMOTE_PUSH=false              # push proposal branches from the runners
# ALGOPS_MASTER_GIT_PROVIDER=                   # github | gitlab — open PRs/MRs for promotions
# ALGOPS_MASTER_GIT_PROVIDER_TOKEN=
# ALGOPS_MASTER_GIT_PROVIDER_API_URL=           # e.g. https://gitlab.corp/api/v4

# Deterministic completion notifications (optional; empty => console log)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SMTP_HOST=
NOTIFY_EMAIL_TO=

# --- Runner / slave (any machine that executes runs) ---
ALGOPS_SLAVE_MASTER_URL=http://127.0.0.1:8000  # point at server A: http://<A_IP>:8000
# ALGOPS_SLAVE_LABELS=cpu                       # matched against an algorithm's runs_on
# ALGOPS_SLAVE_CONCURRENCY=1                    # runs executed in parallel on this host
# ALGOPS_SLAVE_ALLOW_PROJECTS=                  # project names this runner may serve (empty => any)
# ALGOPS_SLAVE_LOCAL_PROJECTS=                  # "name=/path;name2=/path2" served from local paths
# ALGOPS_SLAVE_SERVE_TOY=true                   # serve the bundled toy when no local project is set
# ALGOPS_SLAVE_WORK_DIR=./.algops/slave_work    # git mirrors, per-commit worktrees, run dirs
# v1 single-project mode (still supported):
# ALGOPS_SLAVE_PROJECT_NAME=toy-project
# ALGOPS_SLAVE_PROJECT_PATH=

# --- LLM endpoint (M1) ---
# ALGOPS_MASTER_LLM__MODE=external             # none | external | self_hosted
# ALGOPS_MASTER_LLM__BASE_URL=http://<vllm_or_ollama>:8001/v1
# ALGOPS_MASTER_LLM__MODEL=Qwen/Qwen3-8B-Instruct

# --- Production stack (M5; see deploy/docker-compose.full.yml) ---
# ALGOPS_MASTER_DEV_MODE=false                 # run the loop in a Celery worker, not in-process
# ALGOPS_MASTER_COMMAND_BUS=redis              # cross-process command bus
# ALGOPS_MASTER_WS_BACKEND=redis               # cross-process live progress
# ALGOPS_MASTER_CHECKPOINT_BACKEND=postgres    # AsyncPostgresSaver (resumable campaigns)
# ALGOPS_MASTER_ARTIFACT_BACKEND=s3            # MinIO/S3
# ALGOPS_MASTER_S3_ENDPOINT=http://minio:9000
# ALGOPS_MASTER_S3_ACCESS_KEY=algops
# ALGOPS_MASTER_S3_SECRET_KEY=algops-secret
# --- RAG (M3) ---
# ALGOPS_MASTER_RAG_BACKEND=qdrant_neo4j       # memory | qdrant_neo4j
# ALGOPS_MASTER_QDRANT_URL=http://qdrant:6333
# ALGOPS_MASTER_NEO4J_URI=bolt://neo4j:7687
# ALGOPS_MASTER_NEO4J_PASSWORD=algops-neo4j
# ALGOPS_MASTER_RAG_EMBED=hashing              # hashing | fastembed   (fastembed: --extra rag-models)
# ALGOPS_MASTER_RAG_RERANK=noop                # noop | bge
# --- HITL + notifications ---
# ALGOPS_MASTER_REQUIRE_APPROVAL=false         # pause for human approval before each code change
# ALGOPS_MASTER_MCP_NOTIFY=false
# ALGOPS_MASTER_MCP_SERVER_URL=
