# ALGOps master (control plane + API + React UI + scheduler). Runs on server A.
# The web UI is prebuilt into the package (src/algops/master/static/ui) — no Node stage needed.
FROM python:3.12-slim
RUN pip install --no-cache-dir uv
WORKDIR /app

COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY alembic ./alembic
COPY src ./src
# Prod extras so one image serves both the API and the Celery worker.
RUN uv sync --frozen --no-dev --extra prod --extra rag --extra cloud --extra llm

ENV ALGOPS_MASTER_HOST=0.0.0.0 \
    ALGOPS_MASTER_PORT=8000 \
    ALGOPS_MASTER_DEV_MODE=true
EXPOSE 8000
CMD ["uv", "run", "algops", "master"]
