# ALGOps master (control plane + API + React UI). Runs on server A.
# Multi-stage: build the React frontend, then the Python app serves it at "/".

FROM node:20-slim AS frontend
WORKDIR /fe
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --no-audit --no-fund --loglevel=error
COPY frontend/ ./
RUN npm run build   # -> /fe/dist

FROM python:3.12-slim
RUN pip install --no-cache-dir uv
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
# Install prod extras so one image serves both the API and the Celery worker.
RUN uv sync --no-dev --extra prod --extra rag --extra cloud --extra llm
COPY --from=frontend /fe/dist ./frontend/dist

ENV ALGOPS_MASTER_HOST=0.0.0.0 \
    ALGOPS_MASTER_PORT=8000 \
    ALGOPS_MASTER_DEV_MODE=true
EXPOSE 8000
CMD ["uv", "run", "algops-master"]
